# Copy this file to .env and fill in real values.
# .env is loaded by `set -a; source .env; set +a` before running workers,
# or via docker-compose env_file directive.

# ── Redis ───────────────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379
STREAM_NAME=leads

# ── LeadIngestApi ───────────────────────────────────────
API_PORT=8080

# ── EmailWorker (SMTP) ──────────────────────────────────
# Local dev: MailHog
SMTP_HOST=mailhog
SMTP_PORT=1025
SMTP_FROM=hello@acme.com

# Production (e.g. Resend):
# SMTP_HOST=smtp.resend.com
# SMTP_PORT=465
# SMTP_USER=resend
# SMTP_PASS=re_xxx
# SMTP_FROM=hello@yourdomain.com

# ── CrmWorker ───────────────────────────────────────────
# Local dev: json-server
CRM_URL=http://mock-crm/leads

# Production (e.g. HubSpot):
# CRM_URL=https://api.hubapi.com/crm/v3/objects/contacts
# CRM_API_TOKEN=pat-na1-xxx

# ── AnalyticsWorker (Postgres / Redshift) ───────────────
# Local dev: Postgres
DB_URL=jdbc:postgresql://postgres:5432/analytics
DB_USER=analytics
DB_PASS=analytics

# Production (AWS Redshift):
# DB_URL=jdbc:redshift://your-cluster.redshift.amazonaws.com:5439/analytics
# DB_USER=admin
# DB_PASS=xxx
